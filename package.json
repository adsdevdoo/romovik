{
  "name": "romovik",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ROMовик — архив дампов ПЗУ и истории устройств",
  "scripts": {
    "dev": "node scripts/prepare.mjs && astro dev --host 127.0.0.1",
    "build": "node scripts/prepare.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/prepare.mjs --check",
    "add-dump": "node scripts/add-dump.mjs",
    "inspect-dump": "node scripts/inspect-dump.mjs",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "sync-catalog": "node scripts/sync-catalog.mjs",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.14",
    "@astrojs/sitemap": "3.7.6",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "node": "22.23.4"
  }
}
