---
const { compact = false } = Astro.props;
---
<svg viewBox="0 0 440 340" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class:list={['chip-art', { compact }]}>
  <defs>
    <pattern id="dots" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#52635b" opacity=".4"/></pattern>
    <linearGradient id="body" x1="130" y1="60" x2="305" y2="300" gradientUnits="userSpaceOnUse"><stop stop-color="#35473f"/><stop offset="1" stop-color="#16241f"/></linearGradient>
    <linearGradient id="pins" x1="110" y1="0" x2="330" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#78857c"/><stop offset=".3" stop-color="#e3d6b9"/><stop offset=".6" stop-color="#78857c"/><stop offset="1" stop-color="#dbcead"/></linearGradient>
  </defs>
  <rect width="440" height="340" fill="url(#dots)"/>
  <g stroke="#506555" opacity=".55"><path d="M0 84h78l28 28h36M440 72h-61l-32 32h-38M0 260h72l30-30h40M440 278h-64l-38-38h-29M220 0v53M220 290v50"/><circle cx="78" cy="84" r="4"/><circle cx="376" cy="278" r="4"/></g>
  <g transform="rotate(-12 220 170)">
    {[0,1,2,3,4,5,6,7].map(i => <g fill="url(#pins)"><rect x="113" y={70+i*26} width="37" height="12" rx="2"/><rect x="290" y={70+i*26} width="37" height="12" rx="2"/></g>)}
    <rect x="142" y="50" width="160" height="237" rx="10" fill="#0e1915" opacity=".4" transform="translate(5 9)"/>
    <rect x="140" y="48" width="160" height="237" rx="10" fill="url(#body)" stroke="#617165"/>
    <path d="M198 49a22 22 0 0 0 44 0" fill="#18281f" stroke="#617165"/>
    <rect x="180" y="92" width="80" height="79" rx="20" fill="#142019" stroke="#76846b"/>
    <rect x="191" y="103" width="58" height="57" rx="14" fill="#625941"/>
    <rect x="204" y="116" width="32" height="31" rx="2" fill="#d79b58"/>
    <path d="M209 120h22v23h-22zm5 0v23m6-23v23m6-23v23m-17-17h22m-22 6h22m-22 6h22" stroke="#f4c084" stroke-width=".8"/>
    <text x="164" y="213" fill="#dbe0cf" font-family="monospace" font-size="23" letter-spacing="3">ROMовик</text>
    <text x="165" y="240" fill="#92a28d" font-family="monospace" font-size="11" letter-spacing="2">MEMORY PRESERVED</text>
    <circle cx="155" cy="269" r="4" fill="#92a28d"/>
  </g>
</svg>
