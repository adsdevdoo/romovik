---
import '../styles/global.css';
interface Props { title: string; description: string; noindex?: boolean; structuredData?: unknown; }
const { title, description, noindex = false, structuredData } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const data = structuredData || { '@context': 'https://schema.org', '@type': 'WebSite', name: 'ROMовик', alternateName: 'Romovik', url: Astro.site, description, inLanguage: 'ru' };
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#192a27" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ROMовик" />
    <meta property="og:locale" content="ru_RU" />
    <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">К содержимому</a>
    <header class="site-header">
      <div class="shell flex items-center justify-between gap-5">
        <a class="brand" href="/" aria-label="ROMовик — главная"><img src="/favicon.svg" width="36" height="36" alt="" /><span>ROM<span class="brand-tail">овик</span></span></a>
        <nav aria-label="Основная навигация" class="flex items-center gap-6 sm:gap-8">
          <a href="/#catalog" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Каталог</a>
          <a href="/about/" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>Об архиве</a>
          <a href="/submit/" aria-current={Astro.url.pathname === '/submit/' ? 'page' : undefined}>Прислать дамп</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer shell">
      <div><a class="brand text-lg" href="/">ROMовик</a><p>У каждого чипа есть история.</p></div>
      <div class="footer-links"><a href="/about/">Об архиве</a><a href="/submit/">Прислать дамп</a><a href="/dumps/catalog.json">Каталог JSON</a><a href="https://github.com/adsdevdoo/romovik">Исходный код</a><a href="/moderation/">Модерация</a></div>
    </footer>
  </body>
</html>
